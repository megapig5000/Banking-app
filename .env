# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=root
DB_PASSWORD=password
DB_NAME=simple_bank

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_for_development
JWT_EXPIRES_IN=1h

# API and Frontend Configuration
PORT=3000
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Auto seed database on start, useful for development and testing (default: false)
SEED_ON_START=true